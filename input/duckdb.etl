// Ejecutar scripts/create_demo_data.py antes de correr este pipeline.
PIPELINE ventas_por_cliente {
    FROM DUCKDB(file: "ventas.duckdb", table: "ventas")
        AS TABLE[cliente_id: INT, monto: DECIMAL?, fecha: DATETIME];
    FILL_NULL { monto = 0; }
    FILTER { WHERE monto > 0; }
    AGGREGATE {
        GROUP_BY cliente_id;
        SUM(monto) AS total;
        COUNT() AS cantidad;
    }
    SORT { BY total DESC, cliente_id; }
    TO PARQUET(file: "out/ventas_por_cliente.parquet");
}
