// ETL principal en forma lineal: SQLite -> limpieza de nulos -> agregación -> Parquet
PIPELINE credit_risk {
    FROM SQLITE(file: "bank.db", table: "clients");
    FILL_NULL { debt = 0; }
    FILTER { WHERE income IS NOT NULL AND income > 0 AND debt >= 0; }
    DERIVE {
        debt_ratio = SAFE_DIVIDE(debt, income);
        segment_label = COALESCE(segment, "UNKNOWN");
    }
    DERIVE { risk_flag = debt_ratio IS NULL; }
    AGGREGATE {
        GROUP_BY segment_label;
        COUNT() AS total_clients;
        COUNT(debt_ratio) AS ratios_available;
        AVG(debt_ratio) AS avg_debt_ratio;
    }
    TO PARQUET(file: "summary.parquet");
}

// Pipeline reutilizable con una interfaz tipada explícita: recibe la tabla
// "orders" de quien lo use y le devuelve "cleaned".
PIPELINE clean_orders {
    FROM INPUT orders: TABLE[id: INT, customer_id: INT, amount: DECIMAL?, status: STRING?];
    DROP_NULLS { COLUMNS id, customer_id; }
    FILL_NULL {
        status = "UNKNOWN";
        amount = 0;
    }
    TO OUTPUT cleaned: TABLE[id: INT, customer_id: INT, amount: DECIMAL, status: STRING];
}

// Composición de pipelines y JOIN de dos entradas. Usa la forma de grafo
// (STEP + FLOW) porque la lineal no admite USE ni JOIN.
PIPELINE order_report {
    SOURCE raw_orders = CSV(file: "orders.csv");
    SOURCE customers = SQLITE(file: "bank.db", table: "customers");
    USE clean_orders AS clean;

    STEP customer_keys = RENAME {
        id AS customer_key;
    }

    STEP joined = JOIN {
        TYPE LEFT;
        ON left.customer_id == right.customer_key;
    }
    STEP selected = SELECT {
        COLUMNS customer_id, amount, status;
    }
    SINK output = CSV(file: "orders_clean.csv");

    FLOW {
        raw_orders -> clean.orders;
        clean.cleaned -> joined.left;
        customers -> customer_keys -> joined.right;
        joined -> selected -> output;
    }
}
