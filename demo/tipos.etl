// Errores de tipos detectados al compilar, sin leer datos:
//   python -m etl_dsl demo/tipos.etl --format check
PIPELINE tipos {
    FROM CSV(file: "ventas.csv") AS TABLE[cliente: STRING, monto: DECIMAL?];
    FILTER { WHERE monto > "100"; }
    AGGREGATE { GROUP_BY cliente; SUM(cliente) AS total; }
    TO CSV(file: "salida.csv");
}
