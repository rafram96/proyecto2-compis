PIPELINE p {
  INPUT ventas: TABLE[id: INT, cliente: INT?, monto: DECIMAL?, etiqueta: STRING?];
  INPUT clientes: TABLE[clave: INT?, nombre: STRING, peso: INT?];
  STEP union = JOIN { TYPE INNER; ON left.cliente == right.clave; VERIFY MANY_TO_ONE; }
  STEP vista = SELECT { COLUMNS id, cliente, monto, etiqueta; }
  OUTPUT resultado: TABLE;
  FLOW { ventas -> union.left; clientes -> union.right; union -> vista -> resultado; }
}
