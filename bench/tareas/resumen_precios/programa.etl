// Inspirada en la consulta 1 de TPC-H, sin su filtro de fecha (el DSL no tiene literales
// de fecha): resumen de cantidades y precios por estado de devolución y de línea.
PIPELINE resumen_precios {
    FROM PARQUET(file: "lineitem.parquet");
    DERIVE { precio_desc = l_extendedprice * (1 - l_discount); }
    DERIVE { cargo = precio_desc * (1 + l_tax); }
    AGGREGATE {
        GROUP_BY l_returnflag, l_linestatus;
        SUM(l_quantity) AS sum_qty;
        SUM(l_extendedprice) AS sum_base_price;
        SUM(precio_desc) AS sum_disc_price;
        SUM(cargo) AS sum_charge;
        AVG(l_quantity) AS avg_qty;
        AVG(l_extendedprice) AS avg_price;
        AVG(l_discount) AS avg_disc;
        COUNT() AS count_order;
    }
    SORT { BY l_returnflag, l_linestatus; }
    TO PARQUET(file: "salida/dsl/resumen_precios.parquet");
}
